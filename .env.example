# This file includes global variables that will be available inside your project
# 1. In the front end code you can access this variables like this: console.log(import.meta.env.VARIABLE_NAME)
# 1. In the back end code you access the variable by importing os and then typing print(os.getenv('VARIABLE_NAME'))

# Back-End Variables
DATABASE_URL=postgres://gitpod:postgres@localhost:5432/example
FLASK_APP_KEY="any key works"
JWT_SECRET_KEY="any key works"
FLASK_APP=src/app.py
FLASK_DEBUG=1
DEBUG=TRUE

# Google Calendar (OAuth2) - ver issue #1 (spike OAuth2), #5 (sync real) y #71 (multi-clinica)
# GOOGLE_CLIENT_ID/SECRET son del cliente OAuth compartido (Google Cloud) -- lo
# que es por clinica es el refresh_token, que ya no vive aqui: cada Clinica lo
# obtiene conectando su cuenta desde /app/perfil (Admin), se guarda en
# Clinica.google_refresh_token (DB), no en variable de entorno.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Envio de email (restablecimiento de password, issue #24) - SMTP de Gmail con app password
# (no la contrasena normal de la cuenta -- generar una en myaccount.google.com/apppasswords)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

FRONTEND_URL=http://localhost:5173

# Front-End Variables
VITE_BASENAME=/
#VITE_BACKEND_URL=
